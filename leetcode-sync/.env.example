# Your LeetCode username (visible in your profile URL: leetcode.com/u/USERNAME)
LEETCODE_USERNAME=your_leetcode_username

# Absolute path to your local leetcode-solutions git repo
# Example: C:/Users/atulc/leetcode-solutions
GITHUB_REPO_PATH=C:/Users/you/leetcode-solutions

# ─── AUTO-COOKIE (Default — No manual work!) ─────────────────────────
# Cookies are auto-extracted from your Chrome browser.
# Just stay logged into LeetCode in Chrome — that's it!
# The script will grab cookies automatically when it runs.

# Optional: Chrome profile settings (usually auto-detected)
# CHROME_USER_DATA=C:/Users/you/AppData/Local/Google/Chrome/User Data
# CHROME_PROFILE=Default

# ─── MANUAL COOKIES (Fallback — only if auto-extract fails) ──────────
# LEETCODE_SESSION=paste_here_only_if_needed
# LEETCODE_CSRF_TOKEN=paste_here_only_if_needed
